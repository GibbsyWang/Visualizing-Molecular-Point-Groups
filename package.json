{
  "name": "visualizing-molecular-point-groups",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Lequan Wang and Haibei Li",
  "description": "Interactive molecular point-group visualization web app",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 127.0.0.1 --port 5197 --strictPort",
    "dev:electron": "wait-on tcp:5197 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5197 electron .",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win portable --publish never && powershell -NoProfile -Command \"if (Test-Path 'release/win-unpacked') { Remove-Item -LiteralPath 'release/win-unpacked' -Recurse -Force }\""
  },
  "dependencies": {
    "katex": "^0.16.45",
    "three": "^0.183.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.4",
    "vite": "^6.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.visualizing.molecularpointgroups",
    "productName": "Visualizing Molecular Point Groups",
    "artifactName": "${productName}.exe",
    "icon": "icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
